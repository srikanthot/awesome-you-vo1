# Copy to .env and fill in. Nothing is required for local development with the mock.

# Storage
STORAGE=local                 # local | blob
DATA_DIR=data
BLOB_ACCOUNT_URL=             # https://<account>.blob.core.windows.net

# Alessa (the host is kept out of committed config; set it here)
ALESSA_BASE_URL=              # https://<alessa-host>

# Model (APIM AI Gateway -> Foundry); leave MODEL=fake for local work
MODEL=fake                    # fake | apim
APIM_ENDPOINT=
APIM_KEY=                     # from Key Vault; never commit
MODEL_DEPLOYMENT=
OPENAI_API_VERSION=2024-10-21
